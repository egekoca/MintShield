# Coston2 chain id: 114
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
COSTON2_PRIVATE_KEY=
COSTON2_EXECUTOR_ADDRESS=

# XRP Ledger Testnet
XRPL_TESTNET_RPC_URL=wss://s.altnet.rippletest.net:51233
XRPL_SEED=

# FDC verifier and data-availability layer
VERIFIER_URL_TESTNET=https://fdc-verifiers-testnet.flare.network
VERIFIER_API_KEY_TESTNET=
COSTON2_DA_LAYER_URL=https://ctn2-data-availability.flare.network

# Executor persistence and optional read-only status inputs
EXECUTOR_DB_PATH=./data/mintshield.db
EXECUTOR_WORKER_POLL_INTERVAL_MS=5000
XRPL_ADDRESS=
DESIRED_FXRP_UBA=
MEMO_EXECUTOR_FEE_UBA=0

# Demo adapter deployment cap (100 FXRP at 6 decimals)
MINTSHIELD_ADAPTER_MAX_UBA=100000000
MINTSHIELD_ROUTER_ADDRESS=
STATUS_API_HOST=127.0.0.1
STATUS_API_PORT=8787

# Xaman signing requests (backend only; never expose the secret in browser code)
XAMAN_ENABLE_SIGNING=false
XAMAN_API_KEY=
XAMAN_API_SECRET=
